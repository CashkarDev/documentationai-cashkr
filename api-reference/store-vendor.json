{"openapi":"3.0.1","info":{"title":"Cashkr API — Store Vendor","description":"Store partner authentication and walk-in lead handling.","version":"1.0.0"},"servers":[{"url":"https://internalstg-bk.cashkr.com/api/v1","description":"New Testing Env"}],"tags":[{"name":"Store Vendor"},{"name":"Store Vendor/auth"},{"name":"Store Vendor/lead"}],"security":[{"bearerAuth":[]}],"paths":{"/user/getVendor":{"get":{"summary":"Get store vendor","tags":["Store Vendor/auth"],"parameters":[{"name":"Authorization","in":"header","required":true,"example":"Bearer <YOUR_ACCESS_TOKEN>","schema":{"type":"string"}}],"responses":{"200":{"description":"Store vendor profile","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/otp/verifyotpforvendor":{"post":{"summary":"Verify OTP for vendor","tags":["Store Vendor/auth"],"parameters":[{"name":"Content-Type","in":"header","required":true,"example":"application/json","schema":{"type":"string"}}],"responses":{"200":{"description":"Token issued on successful verification","content":{"application/json":{"schema":{"type":"object"}}}}}}},"/user/registerStoreVendor":{"post":{"summary":"Register a store vendor","tags":["Store Vendor/auth"],"requestBody":{"content":{"multipart/form-data":{"schema":{"type":"object","properties":{"firstName":{"type":"string","example":"Firstname"},"lastName":{"type":"string","example":"Lastname"},"email":{"type":"string","example":"customer@example.com"},"phoneNumber":{"type":"string","example":"9000000000"},"deviceAssigned":{"type":"array","items":{"type":"string"},"example":["Mobile","Laptop"]},"gstin":{"type":"string","example":"22AAAAA0000A1Z5"},"address":{"type":"string","example":"Andheri East, Mumbai"},"shopImg":{"type":"string","format":"binary"},"panCardImg":{"type":"string","format":"binary"},"aadharCardImgFront":{"type":"string","format":"binary"},"aadharCardImgBack":{"type":"string","format":"binary"},"selfPhoto":{"type":"string","format":"binary"}},"required":["firstName","lastName","email","pho